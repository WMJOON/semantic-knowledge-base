# Evidence Collection — MSO v0.7 TTL workflow (SSOT). 옛 YAML+msmwf 에서 이관(2026-10-05). 실행 계약은 skbx: 확장.
@prefix wf:   <https://mso.dev/ontology/workflow#> .
@prefix skbx: <https://skb.dev/ontology/workflow-ext#> .
@prefix w_evidence_collection: <https://example.org/semantic-knowledge-base/workflow/evidence-collection#> .

w_evidence_collection:workflow a wf:Workflow ;
    wf:label "Evidence Collection" ;
    wf:workflowType "base" ;
    skbx:id "evidence-collection" ;
    wf:status "draft" ;
    wf:version "1.0" ;
    skbx:category "evidence" ;
    skbx:mode "dry-run" ;
    skbx:maxRetry 1 ;
    skbx:oracle "evidence_seed_readiness" ;
    skbx:oracleThreshold 0.85 ;
    skbx:hitlRequired false ;
    wf:has w_evidence_collection:start, w_evidence_collection:end, w_evidence_collection:s1 .
w_evidence_collection:start a wf:Node, wf:Start .
w_evidence_collection:end a wf:Node, wf:End .
w_evidence_collection:s1 a wf:Node, wf:Execution, wf:Task ;
    wf:label "run" ;
    wf:inWorkflow w_evidence_collection:workflow ;
    wf:hasSubject "system" ; wf:method "script" ;
    skbx:tool "skb-evidence" ; skbx:action "default" .
w_evidence_collection:r_start_s1 a wf:Edge, wf:Rail ; wf:from w_evidence_collection:start ; wf:railType "default" ; wf:to w_evidence_collection:s1 .
w_evidence_collection:r_s1_end a wf:Edge, wf:Rail ; wf:from w_evidence_collection:s1 ; wf:railType "default" ; wf:to w_evidence_collection:end .
