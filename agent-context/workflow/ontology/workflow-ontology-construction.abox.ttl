# Ontology Construction — MSO v0.7 TTL workflow (SSOT). 옛 YAML+msmwf 에서 이관(2026-10-05). 실행 계약은 skbx: 확장.
@prefix wf:   <https://mso.dev/ontology/workflow#> .
@prefix skbx: <https://skb.dev/ontology/workflow-ext#> .
@prefix w_ontology_construction: <https://example.org/semantic-knowledge-base/workflow/ontology-construction#> .

w_ontology_construction:workflow a wf:Workflow ;
    wf:label "Ontology Construction" ;
    wf:workflowType "base" ;
    skbx:id "ontology-construction" ;
    wf:status "draft" ;
    wf:version "1.0" ;
    skbx:category "ontology" ;
    skbx:mode "dry-run" ;
    skbx:maxRetry 1 ;
    skbx:oracle "ontology_mece_readiness" ;
    skbx:oracleThreshold 0.85 ;
    skbx:hitlRequired true ;
    wf:has w_ontology_construction:start, w_ontology_construction:end, w_ontology_construction:s1 .
w_ontology_construction:start a wf:Node, wf:Start .
w_ontology_construction:end a wf:Node, wf:End .
w_ontology_construction:s1 a wf:Node, wf:Execution, wf:Task ;
    wf:label "run" ;
    wf:inWorkflow w_ontology_construction:workflow ;
    wf:hasSubject "system" ; wf:method "script" ;
    skbx:tool "skb-ontology" ; skbx:action "default" .
w_ontology_construction:r_start_s1 a wf:Edge, wf:Rail ; wf:from w_ontology_construction:start ; wf:railType "default" ; wf:to w_ontology_construction:s1 .
w_ontology_construction:r_s1_end a wf:Edge, wf:Rail ; wf:from w_ontology_construction:s1 ; wf:railType "default" ; wf:to w_ontology_construction:end .
