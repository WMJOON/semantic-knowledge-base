#!/usr/bin/env bash
# skb-graph-reasoning — OWL 2 RL 추론기 (reason | check | stats | status | query)
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILL_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
SIBLING_VENV="$SKILL_DIR/../skb-ontology/.venv/bin/python3"
if [[ -n "${SKB_GRAPH_REASONING_PYTHON:-}" ]]; then PY="$SKB_GRAPH_REASONING_PYTHON"
elif [[ -x "$SIBLING_VENV" ]]; then PY="$SIBLING_VENV"
else PY="python3"; fi
case "${1:-}" in
  reason|check|stats|status|query) exec "$PY" "$SCRIPT_DIR/graph_reasoning.py" "$@" ;;
  ""|-h|--help) exec "$PY" "$SCRIPT_DIR/graph_reasoning.py" --help ;;
  *) echo "usage: skb-graph-reasoning {reason|check|stats|status|query} ..." >&2; exit 2 ;;
esac
