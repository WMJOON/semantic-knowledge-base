#!/usr/bin/env bash
# skb-evidence — CLI entrypoint for the skb-evidence skill.
# Usage: skb-evidence <command> [options]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PY="${PYTHON:-python3}"

sub="${1:-}"
shift || true

case "$sub" in
  collect)
    exec "$PY" "$SCRIPT_DIR/collect.py" "$@"
    ;;
  capture)
    exec "$PY" "$SCRIPT_DIR/capture.py" "$@"
    ;;
  convert)
    exec "$PY" "$SCRIPT_DIR/convert.py" "$@"
    ;;
  ingest)
    exec "$PY" "$SCRIPT_DIR/ingest.py" "$@"
    ;;
  verify)
    # 카탈로그 연동(rdflib·pyshacl)은 선택이다. skb-ontology 의 .venv 가 있으면 그것을 쓴다.
    VENV="$SCRIPT_DIR/../../skb-ontology/.venv/bin/python"
    [ -x "$VENV" ] && PY="$VENV"
    exec "$PY" "$SCRIPT_DIR/verify.py" "$@"
    ;;
  list)
    # 카탈로그 연동(rdflib·pyshacl)은 선택이다. skb-ontology 의 .venv 가 있으면 그것을 쓴다.
    VENV="$SCRIPT_DIR/../../skb-ontology/.venv/bin/python"
    [ -x "$VENV" ] && PY="$VENV"
    exec "$PY" "$SCRIPT_DIR/list_seeds.py" "$@"
    ;;
  verify-quotes)
    exec "$PY" "$SCRIPT_DIR/verify_quotes.py" "$@"
    ;;
  catalog)
    # rdflib 필요. skb-ontology 의 .venv 가 있으면 그것을 쓴다.
    VENV="$SCRIPT_DIR/../../skb-ontology/.venv/bin/python"
    [ -x "$VENV" ] && PY="$VENV"
    exec "$PY" "$SCRIPT_DIR/catalog.py" "$@"
    ;;
  register)
    # rdflib, pyshacl 필요
    VENV="$SCRIPT_DIR/../../skb-ontology/.venv/bin/python"
    [ -x "$VENV" ] && PY="$VENV"
    exec "$PY" "$SCRIPT_DIR/register.py" "$@"
    ;;
  identity)
    # propose|apply|check. rdflib, pyshacl 필요
    VENV="$SCRIPT_DIR/../../skb-ontology/.venv/bin/python"
    [ -x "$VENV" ] && PY="$VENV"
    exec "$PY" "$SCRIPT_DIR/identity.py" "$@"
    ;;
  catalog-validate)
    VENV="$SCRIPT_DIR/../../skb-ontology/.venv/bin/python"
    [ -x "$VENV" ] && PY="$VENV"
    exec "$PY" "$SCRIPT_DIR/catalog_validate.py" "$@"
    ;;
  ""|-h|--help)
    cat <<EOF
skb-evidence — Evidence Collector for SKB v1.1.0

Commands:
  collect   Fetch + chunk + dedup + write seeds
  capture   URL 원문 스냅샷(PDF+PNG+HTML) 박제 (opt-in; requires playwright)
  convert   원문(정적 URL/HTML/PDF/Office) → evidence/raw/ MD 변환 (opt-in; requires docling)
  ingest    [render→]convert→collect 오케스트레이션 (opt-in; requires docling, --render 시 playwright-cli)
  verify    Validate seeds.jsonl integrity
  list      List collected seeds
  verify-quotes   claims.json 의 fact quote 를 원문(evidence/raw)과 글자 단위로 대조 (결정적)
  catalog         seeds.jsonl → 발행자·문서·청크 프로파일 TTL + chunks.jsonl 정규화 (requires rdflib)
  register        카탈로그 문서의 저자·발행 주체·계정 선언을 AgentMention·Account 로 등록 (신원 승격 없음, requires rdflib, pyshacl)
  identity        저자 신원 해소(HITL): propose(후보 큐) → 사람이 decisions.jsonl 작성 → apply → check (requires rdflib, pyshacl)
  catalog-validate  카탈로그 SHACL + TTL↔JSONL 정합 + rawPath 존재 검사 (requires rdflib, pyshacl)

Common options:
  --target PATH       KB root (default: .)

collect options:
  --source URI [...]  One or more URIs (URL or file path)
  --sources-file PATH File containing URIs, one per line
  --chunk-size INT    Max chunk size in chars (default: 1200)
  --chunk-overlap INT Overlap between chunks (default: 100)
  --cluster NAME      Ontology cluster hint (stored as metadata)
  --apply             Actually write files (default: dry-run)
  --dry-run           Plan only, no writes (default)
  --max-retry INT     HTTP retry limit (default: 1)
  --user-agent STR    HTTP User-Agent (default: skb-evidence/1.0)
  --run-id STR        Trajectory run identifier
  --capture           URL 소스 원문 스냅샷 캡처 후 seed.snapshot 기록 (opt-in)

capture options:
  --url URL           캡처할 URL (필수)
  --target PATH       KB root (출력: <target>/evidence/captures/<sha>.{pdf,png,html})
  --outdir DIR        출력 디렉토리 직접 지정 (--target 대체)

convert options:
  --source URI        정적 URL 또는 로컬 파일 (HTML/PDF/DOCX/XLSX/PPTX)
  --source-url URL    중간 파일 변환 시 원본 URL (provenance)
  --target PATH       KB root (출력: <target>/evidence/raw/<slug>.md)

ingest options:
  --source URI [...]  수집할 소스 (URL 또는 파일 경로)
  --sources-file PATH File containing URIs, one per line
  --render            URL을 playwright-cli로 렌더링 후 변환 (JS-rendered 페이지, opt-in)
  --cluster NAME      Ontology cluster hint
  --apply             Actually write files (default: dry-run)

verify options:
  --id SEED_ID        Verify a specific seed
  --shallow           본문-해시 대조 생략 (id 중복·snapshot·uri·raw 메타 검사는 유지)

verify-quotes options:
  --claims PATH       claims.json (필수). 항목: id, type(fact|inference), raw, quote, basis
  --report PATH       [claim-id] 로 인용하는 보고서 md (선택)
  --min-len/--max-len quote 길이 범위 (기본 40~250)

register options:
  --base IRI          인스턴스 IRI 접두 (끝 슬래시 포함, 기본: https://example.org/skb/)
  --source URL        이 URL 의 문서만 (여러 번 가능)
  --apply             evidence/registrations/<document-key>.ttl 을 쓴다 (기본 dry-run)
  --check             써 둔 등록 파일 전체를 도메인 SHACL 로 재검증

identity options:
  propose|apply|check 중 하나. --target, --base IRI(끝 슬래시 포함)
  --max-clusters N    propose: 이름 군집 후보 상한 (기본 50, 영향 문서 수 순)
  --apply             propose: review-queue.jsonl 을 쓴다 / apply: identifications.ttl 을 쓴다 (기본 dry-run)
  결정은 evidence/identity/decisions.jsonl 에 사람이 쓴다(reviewer 필수, 에이전트 이름 거부)

catalog options:
  --base IRI          인스턴스 IRI 접두 (기본: https://example.org/skb/evidence-catalog/)
  --chunk-size/--chunk-overlap  chunker 설정 선언(seed 에 기록되지 않음)
  --apply             파일을 쓴다 (기본 dry-run)

list options:
  --format table|json|ids   Output format (default: table)
EOF
    ;;
  *)
    echo "unknown subcommand: $sub" >&2
    echo "Use 'skb-evidence --help' for usage." >&2
    exit 2
    ;;
esac
