# 현재 소속은 저장하지 않고 조회로 계산한다. Membership 이 사실 기록이고 이 결과는 파생값이다.
# 바인딩: ?asOf (xsd:date) — 유효 시간 기준일. 관찰 시간(prov:generatedAtTime)이 아니다.
# 규칙: '가장 최근 시작일 1건'으로 고르지 않는다. 그렇게 하면 충돌하는 기록을 조용히 덮어쓴다.
#       기준일에 성립할 수 있는 행을 모두 돌려주고 확실성(certainty)과 충돌 여부를 함께 표시한다.
PREFIX sa:  <https://skb.dev/ontology/source-agents#>
PREFIX org: <http://www.w3.org/ns/org#>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT ?person ?organization ?membership
       ?certainty ?hasConflict
WHERE {
  ?membership a sa:Membership ;
      org:member ?person ; org:organization ?organization ;
      sa:startStatus ?startStatus ; sa:endStatus ?endStatus .
  OPTIONAL { ?membership sa:memberSince ?from }
  OPTIONAL { ?membership sa:memberUntil ?until }
  FILTER(?startStatus = "unknown" || ?from <= ?asOf)
  FILTER(?endStatus != "ended" || ?until > ?asOf)
  BIND(IF(?endStatus = "open" && ?startStatus = "known", "confirmed", "unverified") AS ?certainty)
  BIND(EXISTS { ?membership sa:conflictsWith ?x } || EXISTS { ?y sa:conflictsWith ?membership } AS ?hasConflict)
}
ORDER BY ?person ?organization
