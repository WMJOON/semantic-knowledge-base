    skos:notation "3" ;
    skos:prefLabel "Trust Level High"@en,
        "신뢰 수준 상"@ko ;
    skos:scopeNote "순서 3."@ko ;
    prov:hadPrimarySource <https://skb.dev/ontology/source-agents/proposal/2026-10-06-source-agents-port> ;
    skb:status "draft" .

<https://skb.dev/ontology/source-agents/concept-scheme/trust-factors> a skos:ConceptScheme ;
    skos:prefLabel "신뢰 요인"@ko .

<https://skb.dev/ontology/source-agents/concept-scheme/source-agent-roles> a skos:ConceptScheme ;
    skos:prefLabel "출처 에이전트 역할"@ko .

<https://skb.dev/ontology/source-agents/concept-scheme/trust-levels> a skos:ConceptScheme ;
    skos:prefLabel "신뢰 수준"@ko .

<https://skb.dev/ontology/source-agents/concept#identity-method-strength-strong> a skos:Concept ;
    rdfs:label "Strong Identity Evidence"@en ;
    dcterms:identifier "concept:identity-method-strength-strong" ;
    skos:inScheme <https://skb.dev/ontology/source-agents/concept-scheme/identity-methods> ;
