    prov:hadPrimarySource <https://skb.dev/ontology/source-agents/proposal/2026-10-06-source-agents-port> ;
    skb:status "draft" .

<https://skb.dev/ontology/source-agents/concept-scheme/identity-methods> a skos:ConceptScheme ;
